{
  "name": "matdis-maxflow-visualizer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "convert:yaml": "python scripts/convert_yaml_to_topology.py",
    "gen:traces": "tsx dev/sampleTrace.ts",
    "gen:data": "npm run convert:yaml && npm run build:map && npm run gen:traces",
    "build:map": "node scripts/build_map_data.mjs"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.9",
    "@types/leaflet": "^1.9.16",
    "@types/node": "^22.13.5",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.11",
    "jsdom": "^26.1.0",
    "prettier": "^3.5.2",
    "tailwindcss": "^4.0.9",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vitest": "^4.1.12",
    "vue-tsc": "^3.3.14"
  },
  "overrides": {
    "glob": "^14.0.2",
    "minimatch": "^11.0.1"
  }
}
